# Server Settings
MCP_TRANSPORT=sse          # Options: sse, stdio
MCP_PORT=8000
MCP_HOST=0.0.0.0

# Threat Intel / CTI
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# Microsoft Sentinel
SENTINEL_WORKSPACE_ID=your_log_analytics_workspace_id
SENTINEL_TENANT_ID=your_azure_tenant_id
SENTINEL_CLIENT_ID=your_azure_client_id
SENTINEL_CLIENT_SECRET=your_azure_client_secret

# Splunk Enterprise / Cloud
SPLUNK_HOST=splunk.yourdomain.com
SPLUNK_PORT=8089
SPLUNK_TOKEN=your_splunk_hec_or_rest_token
SPLUNK_VERIFY_SSL=false

# Wazuh
WAZUH_API_HOST=wazuh.yourdomain.com
WAZUH_API_PORT=55000
WAZUH_USER=wazuh-api-user
WAZUH_PASSWORD=wazuh-api-password
WAZUH_VERIFY_SSL=false

# IBM QRadar
QRADAR_HOST=qradar.yourdomain.com
QRADAR_SEC_TOKEN=your_qradar_authorized_service_token
QRADAR_VERIFY_SSL=false

# Securonix SNYPR
SECURONIX_HOST=securonix.yourdomain.com
SECURONIX_API_TOKEN=your_securonix_token
